# ─── Required ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/dhagaji?retryWrites=true&w=majority

# Auth.js / NextAuth v5 — generate: openssl rand -base64 32
AUTH_SECRET=

# ─── Production URL (custom domain) ─────────────────────────────────────────
# APIs are same-origin (/api/*) — this domain serves both UI + API
AUTH_URL=https://admin.dhagajicreation.com
AUTH_TRUST_HOST=true

# ─── Owner login (auto-created on first DB connect if missing) ──────────────
OWNER_NAME=Dhagaji Owner
OWNER_EMAIL=owner@dhagaji.com
OWNER_PASSWORD=
