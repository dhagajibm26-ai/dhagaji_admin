# ─── Required (app will not work without these) ─────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/dhagaji?retryWrites=true&w=majority

# Auth.js / NextAuth v5 secret — generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# ─── Recommended for production ─────────────────────────────────────────────
# Full public URL of the deployed app (required if NOT on Vercel)
# Example: https://dhagaji-admin.vercel.app
AUTH_URL=

# On Vercel this is usually auto-trusted. Set to true only if self-hosting
# behind a reverse proxy and you cannot set AUTH_URL.
# AUTH_TRUST_HOST=true

# ─── Optional — used only by scripts/seed.mjs (local one-time seed) ─────────
# OWNER_NAME=Dhagaji Owner
# OWNER_EMAIL=owner@dhagaji.com
# OWNER_PASSWORD=
